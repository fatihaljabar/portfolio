# Postgres connection string used by Prisma
DATABASE_URL=

# Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=

# Public anon key, safe to ship to the client
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key used for Storage uploads, never exposed to the client
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated allowlist of email addresses permitted to sign in to /admin
ADMIN_EMAILS=

# The site's own public URL, used for metadata and sitemap generation
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Display name used in metadata
NEXT_PUBLIC_SITE_NAME=
