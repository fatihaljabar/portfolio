// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ========================================
// PROJECT MODELS
// ========================================

model Project {
  id            String   @id @default(cuid())
  slug          String   @unique
  titleEn       String
  titleId       String
  descriptionEn String
  descriptionId String
  contentEn     String   @db.Text
  contentId     String   @db.Text
  imageUrl      String?
  isFeatured    Boolean  @default(false)
  githubUrl     String?
  demoUrl       String?
  techStack     String[]
  category      String?
  isPublished   Boolean  @default(true)
  publishedAt   DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([slug])
  @@index([isFeatured])
  @@index([category])
}

// ========================================
// ACHIEVEMENT MODELS
// ========================================

model Achievement {
  id           String   @id @default(cuid())
  slug         String   @unique
  titleEn      String
  titleId      String
  descriptionEn String?
  descriptionId String?
  issuer       String
  certificateNumber String?
  credentialUrl String?
  imageUrl     String?
  additionalImages String[] @default([])
  issuedDate   DateTime
  type         AchievementType
  category     String?
  isPublished  Boolean  @default(true)
  publishedAt  DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([slug])
  @@index([type])
  @@index([category])
}

enum AchievementType {
  PROFESSIONAL
  ACADEMIC
  COURSE
  BOOTCAMP
  CERTIFICATION
}

// ========================================
// SKILL MODELS (Home page)
// ========================================

model Skill {
  id        String   @id @default(cuid())
  name      String   @unique
  category  String
  color     String
  createdAt DateTime @default(now())

  @@index([category])
}

// ========================================
// CAREER & EDUCATION MODELS (About page)
// ========================================

model Career {
  id                 String    @id @default(cuid())
  positionEn         String
  positionId         String
  company            String
  companyLogoUrl     String?
  employmentTypeEn   String
  employmentTypeId   String
  location           String
  startDate          DateTime
  endDate            DateTime?
  responsibilitiesEn String    @db.Text
  responsibilitiesId String    @db.Text
  learnedEn          String    @db.Text
  learnedId          String    @db.Text
  impactEn           String    @db.Text
  impactId           String    @db.Text
  isPublished        Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([isPublished])
  @@index([startDate])
}

model Education {
  id                   String    @id @default(cuid())
  university           String
  degreeEn             String
  degreeId             String
  gpaEn                String?
  gpaId                String?
  location             String
  logoUrl              String?
  startDate            DateTime
  endDate              DateTime?
  thesisLabelEn        String?
  thesisLabelId        String?
  thesisProjectTitleEn String?
  thesisProjectTitleId String?
  thesisDetailsEn      String?   @db.Text
  thesisDetailsId      String?   @db.Text
  thesisProjectSlug    String?
  thesisJournalUrl     String?
  thesisJournalLabelEn String?
  thesisJournalLabelId String?
  isPublished          Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([isPublished])
  @@index([startDate])
}

// ========================================
// MESSAGE MODELS (Contact Form)
// ========================================

model Message {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([ipAddress])
}

// ========================================
// LOVE FEATURE MODELS (No Auth)
// ========================================

model Love {
  id        String   @id @default(cuid())
  ipAddress String   // Using IP address as identifier (no auth)
  userAgent String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ipAddress])
  @@index([ipAddress])
}

// Analytics for love clicks
model LoveAnalytics {
  id        String   @id @default(cuid())
  ipAddress String
  userAgent String?
  referrer  String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
